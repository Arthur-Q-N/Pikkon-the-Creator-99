from google.colab import files
import io

def upload_and_process():
    config = ConfigManager()
    orchestrator = YouTubeShortsOrchestrator(config)

    print("=" * 60)
    print("🎬 YOUTUBE SHORTS AUTOMATION")
    print("=" * 60)
    print("\n📤 Faça upload do seu vídeo MP4 (máx 2 minutos)...")

    uploaded = files.upload()

    if not uploaded:
        print("❌ Nenhum arquivo enviado!")
        return

    video_filename = list(uploaded.keys())[0]

    temp_video_path = f"/tmp/{video_filename}"
    with open(temp_video_path, 'wb') as f:
        f.write(uploaded[video_filename])

    print(f"\n✅ Arquivo recebido: {video_filename}")
    print("🚀 Iniciando processamento...\n")

    result = orchestrator.process_video(temp_video_path)

    if result:
        video_path, metadata_path = result

        print("\n" + "=" * 60)
        print("✅ PROCESSAMENTO CONCLUÍDO!")
        print("=" * 60)

        with open(metadata_path, 'r', encoding='utf-8') as f:
            metadata_content = f.read()

        print("\n📝 METADADOS GERADOS:\n")
        print(metadata_content)

        print("\n" + "=" * 60)
        print("💾 BAIXANDO ARQUIVOS FINAIS...")
        print("=" * 60)

        files.download(video_path)
        files.download(metadata_path)

        print("\n✅ Download concluído! Verifique seus arquivos.")
    else:
        print("\n❌ Erro no processamento. Verifique os logs acima.")

