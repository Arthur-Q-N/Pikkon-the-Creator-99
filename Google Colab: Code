class VideoCompiler:
    @staticmethod
    def compile_final_video(
        input_video: Path,
        metadata: VideoMetadata,
        output_video: Path
    ) -> bool:
        try:
            metadata_file = output_video.parent / "metadata.txt"

            with open(metadata_file, 'w', encoding='utf-8') as f:
                f.write(f"Título: {metadata.titulo}\n\n")
                f.write(f"Descrição:\n{metadata.descricao}\n\n")
                f.write(f"Tags: {', '.join(metadata.tags)}\n\n")
                if metadata.analise_agente2:
                    f.write(f"Análise:\n{metadata.analise_agente2}\n\n")
                f.write(f"Score Viral: {metadata.score_viral or 0:.1f}/100\n")

            shutil.copy2(input_video, output_video)

            logger.info(f"Vídeo compilado: {output_video}")
            logger.info(f"Metadados salvos: {metadata_file}")
            return True

        except Exception as e:
            logger.error(f"Erro na compilação: {e}")
            return False

