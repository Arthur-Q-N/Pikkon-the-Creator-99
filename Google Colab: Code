# BLOCO 10: ORQUESTRADOR PRINCIPAL
# ============================================================================

class YouTubeShortsOrchestrator:
    def __init__(self, config: ConfigManager):
        self.config = config
        self.transcriber = TranscriptionService(config.hf_api_key)
        self.agent1 = Agent1ContentGenerator(config.hf_api_key)
        self.agent2 = Agent2Optimizer(config.poe_api_key)
        self.audio_processor = AudioProcessor()
        self.video_compiler = VideoCompiler()

    def process_video(self, video_path: str) -> Optional[Tuple[str, str]]:
        paths = None
        try:
            paths = self._setup_paths(video_path)
            logger.info("=" * 60)
            logger.info("INICIANDO PIPELINE DE PROCESSAMENTO")
            logger.info("=" * 60)

            if not self.audio_processor.extract_audio(paths.video_input, paths.audio_extract):
                raise Exception("Falha na extração de áudio")

            transcription = self.transcriber.transcribe(paths.audio_extract)
            if not transcription:
                raise Exception("Falha na transcrição")
            logger.info(f"Transcrição: {transcription[:100]}...")

            logger.info("\n--- AGENTE 1: Primeira Geração ---")
            metadata_v1 = self.agent1.generate_metadata(transcription)
            if not metadata_v1:
                raise Exception("Falha na geração inicial")

            logger.info("\n--- AGENTE 2: Análise Crítica ---")
            feedback, viral_score = self.agent2.analyze_and_optimize(metadata_v1)

            logger.info("\n--- AGENTE 1: Aplicando Melhorias ---")
            metadata_final = self.agent1.generate_metadata(transcription, feedback)
            if not metadata_final:
                metadata_final = metadata_v1

            video_metadata = VideoMetadata(
                titulo=metadata_final['titulo'],
                descricao=metadata_final['descricao'],
                tags=metadata_final['tags'],
                analise_agente2=feedback,
                score_viral=viral_score
            )

            if not self.video_compiler.compile_final_video(
                paths.video_input,
                video_metadata,
                paths.video_output
            ):
                raise Exception("Falha na compilação")

            logger.info("=" * 60)
            logger.info("PROCESSAMENTO CONCLUÍDO COM SUCESSO")
            logger.info("=" * 60)

            return str(paths.video_output), str(paths.video_output.parent / "metadata.txt")

        except Exception as e:
            logger.error(f"Erro no pipeline: {e}")
            return None
        finally:
            if paths:
                self._cleanup(paths)

    def _setup_paths(self, video_path: str) -> ProcessingPaths:
        temp_dir = Path(tempfile.mkdtemp(prefix="shorts_"))
        return ProcessingPaths(
            video_input=Path(video_path),
            audio_extract=temp_dir / "audio.wav",
            video_output=temp_dir / "output_video.mp4",
            temp_dir=temp_dir
        )

    def _cleanup(self, paths: ProcessingPaths):
        try:
            if paths.temp_dir.exists():
                shutil.rmtree(paths.temp_dir)
            logger.info("Arquivos temporários removidos")
        except Exception as e:
            logger.warning(f"Erro na limpeza: {e}")

