class TranscriptionService:
    MODEL = "mistralai/Voxtral-Small-24B-2507"

    def __init__(self, hf_api_key: str):
        self.client = InferenceClient(token=hf_api_key)
        logger.info(f"Serviço de transcrição inicializado: {self.MODEL}")

    def transcribe(self, audio_path: Path) -> Optional[str]:
        try:
            with open(audio_path, 'rb') as audio_file:
                audio_data = audio_file.read()

            response = self.client.automatic_speech_recognition(
                audio_data,
                model=self.MODEL
            )

            transcription = response.get('text', '')
            logger.info(f"Transcrição concluída: {len(transcription)} caracteres")
            return transcription

        except Exception as e:
            logger.error(f"Erro na transcrição: {e}")
            return None

