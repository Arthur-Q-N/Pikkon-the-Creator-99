        })
        logger.info(f"Agente 2 inicializado: {self.MODEL}")

    def analyze_and_optimize(self, metadata: Dict) -> Tuple[str, float]:
        try:
            prompt = self._build_analysis_prompt(metadata)

            payload = {
                "version": "1.0",
                "type": "query",
                "query": [{
                    "role": "user",
                    "content": prompt
                }],
                "bot": self.MODEL
            }

            response = self.session.post(
                self.API_URL,
                json=payload,
                timeout=60
            )

            if response.status_code == 200:
                result = response.json()
                analysis_text = result.get('text', 'Análise indisponível')
            else:
                logger.warning(f"API Poe retornou status {response.status_code}")
                analysis_text = self._fallback_analysis(metadata)

            viral_score = self._extract_viral_score(analysis_text)
            logger.info(f"Análise concluída - Score Viral: {viral_score}")
            return analysis_text, viral_score

        except Exception as e:
            logger.error(f"Erro no Agente 2: {e}")
            return self._fallback_analysis(metadata), 60.0

    def _build_analysis_prompt(self, metadata: Dict) -> str:
        return f"""{self.SYSTEM_PROMPT}

METADADOS PARA ANÁLISE:

TÍTULO: {metadata.get('titulo', 'N/A')}

DESCRIÇÃO: {metadata.get('descricao', 'N/A')}

TAGS: {', '.join(metadata.get('tags', []))}

EXECUTE UMA ANÁLISE CRÍTICA E DETALHADA:
1. Avalie cada componente separadamente
2. Identifique oportunidades de melhoria
3. Proponha ajustes específicos
4. Calcule score de viralização (0-100)
5. Forneça feedback acionável para o Agente 1"""

    def _extract_viral_score(self, analysis: str) -> float:
        try:
            import re
            for line in analysis.split('\n'):
                if 'score' in line.lower() and 'viral' in line.lower():
                    numbers = re.findall(r'\d+', line)
                    if numbers:
                        score = int(numbers[0])
                        return float(min(max(score, 0), 100))
            return 65.0
        except:
            return 65.0

    def _fallback_analysis(self, metadata: Dict) -> str:
        return f"""ANÁLISE AUTOMÁTICA (Agente 2 - Fallback Mode)

PONTOS FORTES:
✓ Título com {len(metadata.get('titulo', ''))} caracteres
✓ Descrição estruturada presente
