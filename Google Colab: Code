    def __init__(self, hf_api_key: str):
        self.client = InferenceClient(token=hf_api_key)
        logger.info(f"Agente 1 inicializado: {self.MODEL}")

    def generate_metadata(self, transcription: str, feedback: Optional[str] = None) -> Optional[Dict]:
        try:
            prompt = self._build_prompt(transcription, feedback)

            response = self.client.text_generation(
                prompt,
                model=self.MODEL,
                max_new_tokens=1000,
                temperature=0.7,
                return_full_text=False
            )

            metadata = self._parse_response(response)
            logger.info("Metadados gerados pelo Agente 1")
            return metadata

        except Exception as e:
            logger.error(f"Erro no Agente 1: {e}")
            return None

    def _build_prompt(self, transcription: str, feedback: Optional[str]) -> str:
        base_prompt = f"""{self.SYSTEM_PROMPT}

TRANSCRIÇÃO DO VÍDEO:
{transcription}

TAREFA:
Gere metadados otimizados no seguinte formato JSON:
{{
    "titulo": "título atraente (máx 100 caracteres)",
    "descricao": "descrição completa com hashtags integradas (máx 5000 caracteres)",
    "tags": ["tag1", "tag2", "tag3", ...] (mínimo 10, máximo 30 tags)
}}"""

        if feedback:
            base_prompt += f"""

FEEDBACK DO AGENTE 2 (APLIQUE AS MELHORIAS):
{feedback}

IMPORTANTE: Incorpore todas as sugestões de melhoria mantendo a estrutura JSON."""

        return base_prompt

    def _parse_response(self, response: str) -> Dict:
        try:
            start_idx = response.find('{')
            end_idx = response.rfind('}') + 1
            json_str = response[start_idx:end_idx]
            return json.loads(json_str)
        except:
            return {
                "titulo": "Título Padrão",
                "descricao": "Descrição padrão. #shorts",
                "tags": ["shorts", "viral", "trending"]
            }

